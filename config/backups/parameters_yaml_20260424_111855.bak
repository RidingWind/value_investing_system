# config/parameters.yaml
# 价值投资自动化选股系统 - 参数清单
# 修改后可通过 API 或 Redis 命令行热更新，或重启服务生效（取决于 hot_reloadable）

version: "3.0"

parameters:
  # ---------- 数据采集 ----------
  - key: "data.tushare.token"
    value: ""
    type: "str"
    scope: "technical"
    description: "Tushare API Token"
    hot_reloadable: false

  - key: "data.primary_source"
    value: "tushare"
    type: "str"
    scope: "technical"
    description: "主数据源标识"
    hot_reloadable: true

  - key: "data.backup_sources"
    value: ["akshare", "baostock"]
    type: "list"
    scope: "technical"
    description: "备用数据源列表"
    hot_reloadable: true

  - key: "data.market.cron"
    value: "30 15 * * 1-5"
    type: "str"
    scope: "technical"
    description: "每日行情采集 Cron 表达式"
    hot_reloadable: true

  # ---------- NLP 模型 ----------
  - key: "nlp.sentiment.model"
    value: "yiyanghkust/fin-labeler-base"
    type: "str"
    scope: "technical"
    description: "情感分析模型名称"
    hot_reloadable: false

  - key: "nlp.entity.model"
    value: "thenlper/gte-large-zh"
    type: "str"
    scope: "technical"
    description: "实体识别模型名称"
    hot_reloadable: false

  - key: "nlp.retriever.model"
    value: "yiyanghkust/fin-retriever-base"
    type: "str"
    scope: "technical"
    description: "语义检索模型名称"
    hot_reloadable: false

  # ---------- 知识库 ----------
  - key: "knowledge.vector_db_path"
    value: "./chroma_db"
    type: "str"
    scope: "technical"
    description: "向量数据库持久化路径"
    hot_reloadable: false

  - key: "knowledge.enable_es"
    value: false
    type: "bool"
    scope: "technical"
    description: "是否启用 Elasticsearch 关键词检索"
    hot_reloadable: true

  # ---------- 信息源评级 ----------
  - key: "rating.source_base_rating"
    value:
      "cninfo.com.cn": "A"
      "sse.com.cn": "A"
      "stcn.com": "B"
      "eastmoney.com": "C"
      "xueqiu.com": "D"
    type: "dict"
    scope: "business"
    description: "来源域名基础评级映射"
    hot_reloadable: true

  # ---------- 六类股票分类 ----------
  - key: "category.slow.min_growth"
    value: 0.02
    type: "float"
    scope: "business"
    description: "缓慢增长型增速下限"
    hot_reloadable: true

  - key: "category.slow.max_growth"
    value: 0.04
    type: "float"
    scope: "business"
    description: "缓慢增长型增速上限"
    hot_reloadable: true

  - key: "category.stable.min_growth"
    value: 0.10
    type: "float"
    scope: "business"
    description: "稳定增长型增速下限"
    hot_reloadable: true

  - key: "category.stable.max_growth"
    value: 0.12
    type: "float"
    scope: "business"
    description: "稳定增长型增速上限"
    hot_reloadable: true

  - key: "category.stable.min_market_cap"
    value: 100000000000
    type: "int"
    scope: "business"
    description: "稳定增长型最低市值（单位：元）"
    hot_reloadable: true

  - key: "category.fast.min_growth"
    value: 0.20
    type: "float"
    scope: "business"
    description: "快速增长型最低增速"
    hot_reloadable: true

  - key: "category.fast.max_industry_growth"
    value: 0.15
    type: "float"
    scope: "business"
    description: "快速增长型行业增速上限"
    hot_reloadable: true

  # ---------- 估值参数 ----------
  - key: "valuation.stable.pe.low"
    value: 10
    type: "int"
    scope: "business"
    description: "稳定增长型合理PE下限"
    hot_reloadable: true

  - key: "valuation.stable.pe.high"
    value: 14
    type: "int"
    scope: "business"
    description: "稳定增长型合理PE上限"
    hot_reloadable: true

  - key: "valuation.fast.pe.low"
    value: 10
    type: "int"
    scope: "business"
    description: "快速增长型合理PE下限"
    hot_reloadable: true

  - key: "valuation.fast.pe.high"
    value: 20
    type: "int"
    scope: "business"
    description: "快速增长型合理PE上限"
    hot_reloadable: true

  - key: "valuation.overvalued_multiplier"
    value: 1.5
    type: "float"
    scope: "business"
    description: "高估倍数阈值（PE超过合理上限的倍数）"
    hot_reloadable: true

  - key: "valuation.rnav.undervalued_discount"
    value: 0.33
    type: "float"
    scope: "business"
    description: "RNAV低估折价阈值"
    hot_reloadable: true

  - key: "valuation.rnav.overvalued_discount"
    value: 0.10
    type: "float"
    scope: "business"
    description: "RNAV高估折价阈值"
    hot_reloadable: true

  # ---------- 择时与信号 ----------
  - key: "timing.atr_multiplier"
    value: 2.0
    type: "float"
    scope: "business"
    description: "ATR容忍倍数"
    hot_reloadable: true

  - key: "timing.ma_period"
    value: 20
    type: "int"
    scope: "business"
    description: "均线周期"
    hot_reloadable: true

  - key: "signal.fast.max_pe"
    value: 25
    type: "int"
    scope: "business"
    description: "快速增长型买入PE上限"
    hot_reloadable: true

  - key: "signal.fast.max_peg"
    value: 1.0
    type: "float"
    scope: "business"
    description: "快速增长型买入PEG上限"
    hot_reloadable: true

  - key: "signal.fast.max_debt_to_equity"
    value: 0.50
    type: "float"
    scope: "business"
    description: "快速增长型最高负债权益比"
    hot_reloadable: true

  - key: "signal.fast.min_ocf_ratio"
    value: 0.80
    type: "float"
    scope: "business"
    description: "快速增长型经营现金流/净利润最低比例"
    hot_reloadable: true

  - key: "signal.fast.sell_pe"
    value: 40
    type: "int"
    scope: "business"
    description: "快速增长型卖出PE阈值"
    hot_reloadable: true

  - key: "signal.fast.sell.sssg_threshold"
    value: -0.03
    type: "float"
    scope: "business"
    description: "快速增长型同店销售下滑卖出阈值"
    hot_reloadable: true

  # ---------- 投资组合管理 ----------
  - key: "portfolio.max_single.fast"
    value: 0.10
    type: "float"
    scope: "business"
    description: "快速增长型单票仓位上限"
    hot_reloadable: true

  - key: "portfolio.max_single.stable"
    value: 0.08
    type: "float"
    scope: "business"
    description: "稳定增长型单票仓位上限"
    hot_reloadable: true

  - key: "portfolio.allocation.fast.min"
    value: 0.25
    type: "float"
    scope: "business"
    description: "快速增长型配置比例下限"
    hot_reloadable: true

  - key: "portfolio.allocation.fast.max"
    value: 0.35
    type: "float"
    scope: "business"
    description: "快速增长型配置比例上限"
    hot_reloadable: true

  - key: "portfolio.cash.permanent_floor"
    value: 0.05
    type: "float"
    scope: "business"
    description: "永续现金底线"
    hot_reloadable: true

  - key: "portfolio.batch.first"
    value: 0.40
    type: "float"
    scope: "business"
    description: "分批建仓第一批比例"
    hot_reloadable: true

  - key: "portfolio.batch.second"
    value: 0.30
    type: "float"
    scope: "business"
    description: "分批建仓第二批比例"
    hot_reloadable: true

  - key: "portfolio.batch.third"
    value: 0.30
    type: "float"
    scope: "business"
    description: "分批建仓第三批比例"
    hot_reloadable: true

  - key: "portfolio.average_down.threshold"
    value: 0.25
    type: "float"
    scope: "business"
    description: "下跌补仓触发阈值"
    hot_reloadable: true

  # ---------- 市场环境 ----------
  - key: "market.pe.high_threshold"
    value: 0.70
    type: "float"
    scope: "business"
    description: "市场高估分位阈值"
    hot_reloadable: true

  - key: "market.pe.low_threshold"
    value: 0.30
    type: "float"
    scope: "business"
    description: "市场低估分位阈值"
    hot_reloadable: true

  # ---------- 回测 ----------
  - key: "backtest.commission"
    value: 0.0003
    type: "float"
    scope: "technical"
    description: "回测佣金费率"
    hot_reloadable: true

  - key: "backtest.slippage"
    value: 0.001
    type: "float"
    scope: "technical"
    description: "回测滑点"
    hot_reloadable: true

  - key: "portfolio.initial_capital"
    value: 100000
    type: "int"
    scope: "technical"
    description: "初始资金（回测/模拟盘）"
    hot_reloadable: true

  # ---------- 财务体检 ----------
  - key: "health.pass_threshold"
    value: 70
    type: "int"
    scope: "business"
    description: "财务体检通过分数"
    hot_reloadable: true

  - key: "health.debt.max_de_ratio"
    value: 0.40
    type: "float"
    scope: "business"
    description: "最高负债权益比"
    hot_reloadable: true

  # ---------- Web 界面 ----------
  - key: "web.session_timeout"
    value: 3600
    type: "int"
    scope: "technical"
    description: "Web登录超时（秒）"
    hot_reloadable: true

  - key: "web.max_export_rows"
    value: 10000
    type: "int"
    scope: "technical"
    description: "导出最大行数"
    hot_reloadable: true